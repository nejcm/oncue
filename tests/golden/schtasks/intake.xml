<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Source>managed-by oncue tender/intake</Source><Description>tender: run the intake rules enabled for this host</Description></RegistrationInfo>
  <Triggers>
    <TimeTrigger><Repetition><Interval>PT15M</Interval></Repetition><StartBoundary>2000-01-01T00:00:00</StartBoundary></TimeTrigger>
  </Triggers>
  <Principals><Principal id="Author"><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;C:\Users\u\AppData\Local\oncue\tender\intake.ps1&quot;</Arguments>
      <WorkingDirectory>C:\Users\u\Work\agent-workflow</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
