<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- managed-by oncue shape/slow-restart -->
<plist version="1.0"><dict>
<key>Label</key><string>shape.slow-restart</string>
<key>WorkingDirectory</key><string>/tmp</string>
<key>ProgramArguments</key><array><string>/usr/bin/true</string></array>
<key>StandardOutPath</key><string>/home/u/Library/Logs/shape-slow-restart.log</string>
<key>StandardErrorPath</key><string>/home/u/Library/Logs/shape-slow-restart.log</string>
<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict><key>ThrottleInterval</key><integer>90</integer>
</dict></plist>
