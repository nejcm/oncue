{
  "name": "@nejcm/oncue",
  "version": "0.3.0",
  "description": "Install jobs into the native OS scheduler: systemd, launchd, Task Scheduler",
  "keywords": [
    "bun",
    "cli",
    "launchd",
    "scheduler",
    "schtasks",
    "systemd",
    "task-scheduler",
    "timer"
  ],
  "homepage": "https://github.com/nejcm/oncue#readme",
  "bugs": {
    "url": "https://github.com/nejcm/oncue/issues"
  },
  "license": "MIT",
  "author": "nejcm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nejcm/oncue.git"
  },
  "bin": {
    "oncue": "./src/cli.ts"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:node": "bun build src/bin.ts --target=node --outfile dist/oncue.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "knip": "knip",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run knip"
  },
  "devDependencies": {
    "bun-types": "^1.3.0",
    "knip": "6.48.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.5",
  "knip": {
    "entry": [
      "src/bin.ts"
    ]
  }
}
