# managed-by oncue tender/intake
[Unit]
Description=tender: run the intake rules enabled for this host

[Service]
Type=oneshot
WorkingDirectory=/home/u/Work/agent-workflow
ExecStart="/home/u/.bun/bin/bun" "tender.ts" "intake" "--config" "tender.json"
Environment="PATH=/home/u/.bun/bin:/home/u/.local/bin:/usr/local/bin:/usr/bin:/bin"
