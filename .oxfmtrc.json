{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "endOfLine": "lf",
  "printWidth": 120,
  "trailingComma": "all",
  "arrowParens": "always",
  "ignorePatterns": ["**/*.md", "tests/golden/**", "tests/fixtures/**", "bun.lock"]
}
